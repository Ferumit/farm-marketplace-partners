<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. The Firebase emulators speak plain HTTP on the machine that runs them, and
  Android has blocked cleartext since Android 9, so without this a debug build started with
  ET_EMULATOR=true fails every call with "An internal error has occurred". Release builds never
  see this file: production stays HTTPS only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
