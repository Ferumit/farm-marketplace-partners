# Телефоны, которым разрешено сделать себя администратором, пока администраторов ещё нет.
# Через запятую, в международном формате.
BOOTSTRAP_ADMIN_PHONES=+70000000000

# Кто платит онлайн. Списки uid через запятую; `*` в ET_PAYING_PARTNERS — платят у всех хозяйств.
# Решение записывается НА ЗАКАЗ при создании, поэтому правка здесь не меняет уже сделанные заказы.
ET_PAYING_BUYERS=
ET_PAYING_PARTNERS=

# Контур онлайн-кассы: боевой https://app.rekassa.kz/partner, тестовый app-test.rekassa.kz.
# Пустое значение полностью выключает фискализацию.
REKASSA_BASE=https://app-test.rekassa.kz/partner
